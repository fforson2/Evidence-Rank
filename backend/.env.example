# Local origins allowed to call the API. Comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. The demo runs on in-memory fixtures without these.
# Keep the service-role key on the backend only. Never expose it to the browser
# or prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used only by POST /analysis/rank. The demo feed runs without it.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
RAG_MIN_SCORE=0.3
